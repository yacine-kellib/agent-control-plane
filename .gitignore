*.key
__pycache__/
.DS_Store

# Build outputs. These are also what keeps them out of the signed manifest:
# tools/sign-release.sh takes its file set from `git ls-files`, so anything
# ignored here is excluded from coverage by construction rather than by a
# deny-list in the signer. That is why this file is itself signed.
target/
node_modules/
dist/
*.tsbuildinfo

# Private working material, never signed, never published.
private/

# Local agent tooling: settings, hooks, skills, session handoffs. These are one
# contributor's machine configuration, not part of the release, and they are
# excluded from the signed manifest by construction because the signer takes
# its file set from `git ls-files`.
.claude/
