*.key
__pycache__/
.DS_Store

# Build outputs. These are also what keeps them out of the signed manifest:
# tools/sign-release.sh takes its file set from `git ls-files`, so anything
# ignored here is excluded from coverage by construction rather than by a
# deny-list in the signer. That is why this file is itself signed.
target/
node_modules/
dist/
*.tsbuildinfo

# Private working material, never signed, never published.
private/

# Local agent configuration. NOT discarded -- it is versioned in a separate
# private repository (tack-run/claude-env, projects/acp/) because this repo is
# public and .claude/ holds machine settings, hooks and session handoffs.
# Restore with:  ~/DEV/claude-env/sync.sh push acp
# Capture changes with:  ~/DEV/claude-env/sync.sh pull acp
.claude/
